modules = ["nodejs-20", "web", "python-3.11", "python3", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium", "imagemagick"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "reach-north-star-self-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "episode-27-db-sync-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "episode-28-db-sync-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prequel-db-sync-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "read-my-story-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rolling-sync-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "consolidated-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "episode-append-trigger-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "team-room-episode-hook-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-episode-hook-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "replit-attribution-discipline-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chat-episode-hook-e2e-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "merge-ours-guard-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "luca-reflection-episode-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "luca-moment-episode-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "luca-auto-capture-episode-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "capture-status-ordering-ci"


[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(git config merge.ours.driver true && echo '[merge.ours] driver configured' || echo '[merge.ours] WARNING: git config failed — merge=ours will not protect rolling episodes' >&2); (npx tsx server/scripts/restore-rolling-episodes-from-db.ts --check-shrinkage || echo '[rolling-restore] WARNING: shrinkage check failed — continuing' >&2); npm run dev"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[[workflows.workflow]]
name = "reach-north-star-self-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/scripts/test-reach-north-star-e2e.ts --self-check"

[workflows.workflow.metadata]
isValidation = true
outputType = "console"

[[workflows.workflow]]
name = "episode-27-db-sync-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/scripts/test-episode-27-db-sync.ts"

[workflows.workflow.metadata]
isValidation = true

