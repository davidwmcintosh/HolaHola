modules = ["nodejs-20", "web", "python-3.11", "python3", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium", "imagemagick", "gitleaks"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "consolidated-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "replit-attribution-discipline-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "capture-status-ordering-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prior-session-label-clears-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "episode-28-snapshot-write-guard-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "episode-28-startup-shrinkage-selfcheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gl-reconnected-recovery-ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "watchdog-inner-life-ci"


[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(git config merge.ours.driver true && echo '[merge.ours] driver configured' || echo '[merge.ours] WARNING: git config failed — merge=ours will not protect rolling episodes' >&2); (npx tsx server/scripts/restore-rolling-episodes-from-db.ts --check-shrinkage || echo '[rolling-restore] WARNING: shrinkage check failed — continuing' >&2); npm run dev"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[[workflows.workflow]]
name = "consolidated-ci"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash server/scripts/test-all-consolidated-ci.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "replit-attribution-discipline-ci"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/scripts/test-replit-attribution-discipline.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "episode-28-gap-audit-selfcheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/scripts/audit-episode-28-gaps.ts --self-check"

[workflows.workflow.metadata]
isValidation = true
outputType = "console"

