[agent]
integrations = ["javascript_openai_ai_integrations:1.0.0", "javascript_mem_db:1.0.0", "javascript_log_in_with_replit:1.0.0", "stripe:1.0.0", "javascript_gemini_ai_integrations:1.0.0", "javascript_anthropic_ai_integrations:1.0.0", "perplexity_v0:1.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
TTS_PRIMARY_PROVIDER = "google"
CARTESIA_PRONUNCIATION_DICT_IDS = "{\"spanish\":\"pdict_6PLDfmxcwFMXcNzupDAtGN\",\"french\":\"pdict_bH9XV8ysTebsn7NGkQTRVR\",\"german\":\"pdict_x7RvPGuw4MDAgrXmFbuscG\",\"italian\":\"pdict_hzt7xBGNNwTJmPw8T7mVj2\",\"portuguese\":\"pdict_rBkocHMkYSYbFVcnopCqam\",\"japanese\":\"pdict_dZE2eKzRRt71JDoL6XYMvm\",\"mandarin chinese\":\"pdict_VH25Wo8GMJ2GMtEDU8CdWY\",\"korean\":\"pdict_5fsZLioheLeUoJ17TXzSob\"}"
APP_NAME = "HolaHola"
APP_URL = "https://getholahola.com"
FROM_EMAIL = "noreply@getholahola.com"
COMPASS_ENABLED = "true"
DEEPGRAM_MODEL = "nova-3"
DEEPGRAM_INTELLIGENCE_ENABLED = "true"
GEMINI_LIVE_VOICE = "true"
AWS_S3_REGION = "auto"
DEFAULT_OBJECT_STORAGE_BUCKET_ID = "holaholar2bucket"
PRIVATE_OBJECT_DIR = "/holaholar2bucket/.private"
PUBLIC_OBJECT_SEARCH_PATHS = "/holaholar2bucket/public"

[userenv.development]
SYNC_PEER_URL = "https://getholahola.com"
NEON_STRICT_MODE = "true"

[userenv.production]
SYNC_PEER_URL = "https://3ca2376d-c3dc-490a-a375-6b2f97f7c281-00-i0c3jqj8bdra.janeway.replit.dev"
NEON_STRICT_MODE = "true"

[objectStorage]
defaultBucketID = "replit-objstore-cf6ba6d4-2685-4f0a-9ea8-f1861aefef11"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 480000

