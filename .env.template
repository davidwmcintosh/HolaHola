# Copy this to .env and fill in values from Replit Secrets panel
# Run: cp .env.template .env

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Both point to the same Neon connection string — copy from Neon dashboard
# or from Replit Secrets panel under NEON_SHARED_DATABASE_URL
NEON_SHARED_DATABASE_URL=
DATABASE_URL=

# Need an isolated database instead of the shared one above (exploratory
# testing, a Codespace/sandbox environment, anything that shouldn't touch
# shared production data)? Don't add a static variable here — run
# `npm run db:branch -- create <name>` and point NEON_SHARED_DATABASE_URL at
# the branch it prints, for that environment only. See
# .agents/skills/neon-branch/SKILL.md. (A static NEON_TEST_DATABASE_URL used
# to live here; retired 2026-08-30 — see
# docs/superpowers/specs/2026-08-26-claude-code-test-environment-design.md's
# Amendment for why.)

# Neon Management API — used only by scripts/neon-branch.ts to create/list/
# delete branches (see docs/superpowers/specs/2026-08-30-neon-branch-migration-workflow-design.md).
# NEON_API_KEY can create and delete branches; it cannot read table data and
# is never itself a Postgres connection string. Get it from the Neon console
# under Account Settings > API Keys, scoped to the minimum role available.
# NEON_PROJECT_ID is the project slug shown in the Neon console URL/Settings —
# not a secret, but still project-specific.
NEON_API_KEY=
NEON_PROJECT_ID=

# Note: PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE are auto-injected
# by Replit's infrastructure — they do NOT appear in the Secrets panel and
# you do NOT need to set them locally. Use the two variables above instead.

# ── Cross-tool source promotion ───────────────────────────────────────────────
# One shared way for any tool (Claude Code, Replit, Cursor, Antigravity) to get
# a committed branch onto main safely — see .agents/skills/source-promote/SKILL.md
# and docs/superpowers/specs/2026-08-26-unified-source-promote-endpoint-design.md.
# SOURCE_BRIDGE_API_TOKEN authenticates callers to the running app's
# /api/internal/source-promote endpoint — needed both by the server (to check
# incoming requests) and by anyone calling scripts/source-promote.ts.
SOURCE_BRIDGE_API_TOKEN=
# GITHUB_ACTIONS_DISPATCH_TOKEN — a GitHub fine-grained personal access token,
# scoped to this repo only, with "Actions: Read and write" permission (nothing
# else). Used only by the running server to trigger and poll the
# .github/workflows/source-promote.yml run that does the actual validation and
# push — never used to push code directly, never holds repo-write access.
GITHUB_ACTIONS_DISPATCH_TOKEN=

# ── AI providers ─────────────────────────────────────────────────────────────
# Single OpenAI key used everywhere (embeddings, TTS fallback, Realtime API,
# pronunciation analysis). On Replit, AI_INTEGRATIONS_OPENAI_API_KEY is the
# proxy key (set automatically); outside Replit only OPENAI_API_KEY is needed.
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# ── Voice (Deepgram live STT) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Object storage (S3-compatible) ───────────────────────────────────────────
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Primary application/read-path bucket. The legacy name remains active for R2.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# Archive/migration destination; may intentionally match the primary bucket.
AWS_S3_DESTINATION_BUCKET=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Reconciliation replica ────────────────────────────────────────────────────
RECONCILIATION_REPLICA_ENDPOINT=
RECONCILIATION_REPLICA_BUCKET=
RECONCILIATION_REPLICA_REGION=
RECONCILIATION_REPLICA_ACCESS_KEY_ID=
RECONCILIATION_REPLICA_SECRET_ACCESS_KEY=

# ── Session / auth ────────────────────────────────────────────────────────────
SESSION_SECRET=
SYNC_SHARED_SECRET=

# ── Source promotion API (disabled by default) ────────────────────────────────
# Set the flag only after storing a dedicated SOURCE_PROMOTION_TOKEN in Replit
# Secrets. This API prepares and records an explicit Replit Publish; it cannot
# publish programmatically.
SOURCE_PROMOTION_API_ENABLED=false
SOURCE_PROMOTION_TOKEN=

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Misc ──────────────────────────────────────────────────────────────────────
RAW_WINDOW_RECEIPT_PRIVATE_KEY=
RAW_WINDOW_RECEIPT_PRIVATE_KEY_B64=

# ── Local dev only — do NOT set this in production ───────────────────────────
DEV_AUTH_BYPASS=true
